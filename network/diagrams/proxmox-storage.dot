// Hand-written diagram example: Proxmox storage and backup flow.
// `make diagrams` renders every *.dot in this folder to SVG + PNG.
digraph proxmox_storage {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="transparent"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#E9DDF5"];
  edge  [fontname="Helvetica", fontsize=10];

  subgraph cluster_pve {
    label="pve (Proxmox host)"; style="rounded,dashed";
    ssd1 [label="SSD 1\nsystem + guests", shape=cylinder, fillcolor="#D4E6F9"];
    ssd2 [label="SSD 2\nbackups", shape=cylinder, fillcolor="#DCEFD9"];
    guests [label="haos / unifi-controller / gitlab-runner"];
  }
  offsite [label="Offsite copy\nTODO", shape=cylinder, fillcolor="#FBEBD2", style="rounded,filled,dashed"];

  guests -> ssd1 [label="runs on"];
  ssd1 -> ssd2 [label="vzdump\nTODO schedule"];
  ssd2 -> offsite [label="TODO: PBS / rclone", style=dashed];
}
