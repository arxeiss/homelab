# Template for ~/.config/homelab/credentials.env - read-only access used by
# `make check-access`, `make status`, `make mikrotik-export` (see ACCESS.md).
#
#   mkdir -p ~/.config/homelab
#   cp credentials.env.example ~/.config/homelab/credentials.env
#   chmod 600 ~/.config/homelab/credentials.env
#
# Never commit the real file. Use a different location with: make status CREDENTIALS=/path/file.env
# Plain KEY=value lines, sourced by bash: no spaces around "=", quote values with spaces.

# ---- MikroTik: SSH with a key, user in the `readonly` group --------------------
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=claude-ro
# Private key; ~ is expanded
MIKROTIK_KEY=~/.ssh/homelab-ro

# ---- UniFi OS Server: API key of a View Only admin ----------------------------
# UniFi OS Server web UI, including the port (self-hosted UniFi OS Server: 11443)
UNIFI_URL=https://192.168.88.11:11443
UNIFI_API_KEY=replace-me
# Site name used by the classic API, "default" unless you renamed/added sites
UNIFI_SITE=default
# false = accept the self-signed certificate
UNIFI_VERIFY_TLS=false

# ---- Proxmox VE: API token with the PVEAuditor role --------------------------
PVE_URL=https://192.168.88.10:8006
PVE_TOKEN_ID=claude@pve!docs
PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Optional, default false (self-signed certificate)
PVE_VERIFY_TLS=false
